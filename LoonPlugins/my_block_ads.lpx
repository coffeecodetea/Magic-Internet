#!name=量量拦截&净化合集
#!desc=引用fmz200(约20款APP)某些APP要清除缓存或者重新安装拦截广告才会生效！规则明细可以查看本插件的注释
#!author=没啥量[https://github.com/coffeecodetea]
#!icon=https://raw.githubusercontent.com/fmz200/main/icons/apps/AdBlock.png
#!homepage=https://github.com/coffeecodetea/Magic-Internet
#!raw-url=https://github.com/coffeecodetea/Magic-Internet/raw/main/Loon/plugin/blockAds.plugin
#!tg-channel=https://t.me/inaisi
#!category=没啥量模块
#!tag=去广告合集,coffeecodetea,没啥量
#!system=iOS, iPadOS
#!system_version = 
#!loon_version = 3.5.1 (978)
#!date=2026-11-19 07:55:11
#!remark=下方的所有规则都标注了对应的hostname，可能存在错误或者遗漏，欢迎反馈。对于无法/可选MITM的hostname都特别做了“如开启可自行添加主机名”提示，如果提示后面没有标注主机名则包含所有主机名，否则只包含提示语后面的主机名。
# [Rule]和[Rewrite]始终生效，开关仅控制[Script]（复杂净化）部分
#############################################
# "reject"        策略返回 HTTP 状态码 404,不附带任何额外内容
# "reject-200"    策略返回 HTTP 状态码 200,不附带任何额外内容
# "reject-img"    策略返回 HTTP 状态码 200,同时附带 1px gif
# "reject-dict"   策略返回 HTTP 状态码 200,同时附带一个空的 JSON 对象
# "reject-array"  策略返回 HTTP 状态码 200,同时附带一个空的 JSON 数组
#############################################
# 常见问题：
# 1️⃣：我知道规则，不知道主机名怎么办？
# ✅：几乎所有的主机名都是从规则中提取出来的，先有的规则再有的主机名
# 2️⃣：有些常用的软件为什么没有去广告配置？
# ✅：如果要利用重写去广告，就需要对请求或响应信息进行解密(MITM)，现在一些软件已经禁止了MITM，所以就无法去广告。
# 3️⃣：Loon如果在插件里面写了规则，在规则配置里也写了，哪个优先生效？
# ✅：插件里的规则优先生效。
#############################################

[Argument]

# 🧲 12306 🧲
12306_enable = switch,true,false,tag=12306-Script开关

# 🧲 阿里巴巴 🧲
albb_enable = switch,true,false,tag=阿里巴巴-Script开关

# 🧲 阿里云盘 🧲
alyp_enable = switch,true,false,tag=阿里云盘-Script开关

# 🧲 酷安 🧲
kuan_enable = switch,true,false,tag=酷安-Script开关

# 🧲 夸克 🧲
kxke_enable = switch,true,false,tag=夸克-Script开关

# 🧲 脉脉 🧲
mdmd_enable = switch,true,false,tag=脉脉-Script开关

# 🧲 Reddit 🧲
reddit_enable = switch,true,false,tag=Reddit-Script开关

# 🧲 淘宝 🧲
tcbc_enable = switch,true,false,tag=淘宝-Script开关

# 🧲 解除微信链接限制 🧲
lmjpxmvi_enable = switch,true,false,tag=解除微信链接限制-Script开关

[Rule]

